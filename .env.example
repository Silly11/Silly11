# Copy to .env.local for Next.js; export the same values for worker/admin scripts.
APP_URL=http://localhost:3000
DATA_DIR=./data
# Use true only behind a trusted proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=false

# Operational defaults for the first release; publish the retention policy before launch.
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_MS=3600000

# Optional AI. Both values are required; choose a Responses API-compatible model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional verified email notifications (Resend).
RESEND_API_KEY=
EMAIL_FROM=

# Optional recurring subscription: 10 USD per month, priced on the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional account login AND linking. No provider access tokens are retained.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple requires an HTTPS APP_URL. CLIENT_SECRET is your signed, expiring Apple JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
